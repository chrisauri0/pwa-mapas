{
  "name": "angular-pwa",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test:e2e:cn": "firebase emulators:exec --config firebase.emulator.json --project demo-avisos-test --only auth,firestore \"playwright test tests/e2e/caja-negra.e2e.ts\"",
    "watch": "ng build --watch --configuration development",
    "cap:sync": "pnpm build && pnpm exec cap sync android",
    "cap:run": "pnpm cap:sync && pnpm exec cap run android",
    "cap:open": "pnpm exec cap open android",
    "test": "ng test",
    "test:e2e": "firebase emulators:exec --config firebase.emulator.json --project demo-avisos-test --only auth,firestore \"playwright test\"",
    "test:unit": "ng test --watch=false",
    "test:integration": "firebase emulators:exec --config firebase.emulator.json --project demo-avisos-test --only auth,firestore \"vitest run --config vitest.integration.config.ts\"",
    "test:all": "pnpm test:unit && pnpm test:integration",
    "lint": "ng lint"
  },
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/pwa": "^21.2.10",
    "@angular/router": "^21.2.0",
    "@angular/service-worker": "^21.2.0",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capgo/capacitor-pedometer": "^8.0.43",
    "firebase": "^13.1.0",
    "fuse.js": "^7.3.0",
    "leaflet": "^1.9.4",
    "leaflet-distortableimage": "^0.21.9",
    "leaflet-imageoverlay-rotated": "^0.2.1",
    "maplibre-gl": "6.19.0",
    "rxjs": "~7.8.0",
    "socket.io-client": "^4.8.3",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "21.4.0",
    "@angular/build": "^21.2.10",
    "@angular/cli": "^21.2.10",
    "@angular/compiler-cli": "^21.2.0",
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/leaflet": "^1.9.21",
    "@vitest/coverage-v8": "4.1.6",
    "angular-eslint": "21.4.0",
    "eslint": "^10.3.0",
    "firebase-tools": "^15.35.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.59.2",
    "vitest": "^4.0.8"
  }
}
