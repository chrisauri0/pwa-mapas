    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/pwa": "^21.2.10",
    "@angular/router": "^21.2.0",
    "@angular/service-worker": "^21.2.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/geolocation": "^8.2.2",
    "@capgo/capacitor-pedometer": "^8.0.43",
    "fuse.js": "^7.3.0",
    "leaflet": "^1.9.4",
    "leaflet-distortableimage": "^0.21.9",
    "leaflet-imageoverlay-rotated": "^0.2.1",
    "rxjs": "~7.8.0",
    "socket.io-client": "^4.8.3",
